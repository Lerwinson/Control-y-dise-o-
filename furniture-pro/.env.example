# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/furniture_pro?schema=public"

# JWT secret for the Express auth backend
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Express backend port
SERVER_PORT=4000

# URL the Next.js frontend uses to reach the Express API
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
